/* The game's icon set (art/ui-icons: SVG sources, rendered to Content/UI/Icons). An element
   gets `icon` plus one `icon-<name>` class; its size comes from where it is used. */

.icon { flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.icon-coin { background-image: url("/Assets/Content/UI/Icons/coin.png"); }
.icon-backpack { background-image: url("/Assets/Content/UI/Icons/backpack.png"); }
.icon-lamp { background-image: url("/Assets/Content/UI/Icons/lamp.png"); }
.icon-bolt { background-image: url("/Assets/Content/UI/Icons/bolt.png"); }
.icon-bolt-mark { background-image: url("/Assets/Content/UI/Icons/bolt-mark.png"); }
.icon-battery { background-image: url("/Assets/Content/UI/Icons/battery.png"); }
.icon-shovel { background-image: url("/Assets/Content/UI/Icons/shovel.png"); }
.icon-drill { background-image: url("/Assets/Content/UI/Icons/drill.png"); }
.icon-jetpack { background-image: url("/Assets/Content/UI/Icons/jetpack.png"); }
