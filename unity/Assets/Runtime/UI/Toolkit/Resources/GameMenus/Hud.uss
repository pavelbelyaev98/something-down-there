.hud-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}
.hud-root {
    color: var(--paper);
    font-size: 18px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}
.hud-root .unity-text-element { padding: 0; }

/* Resources: money top-left; the upright battery bar bottom-left with bag and lamps beside it. Icons are drawn by
   HudIcons; numbers are set in the menus' display face. */
.hud-number {
    -unity-font: url("/Assets/Content/UI/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 20px; color: #ffffff; margin: 0;
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(20, 14, 8, 0.55);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.55);
}
.hud-number.unlimited { -unity-font: url("/Assets/Content/UI/Fonts/BarlowCondensed-SemiBold.ttf"); font-size: 24px; }
.hud-wallet { position: absolute; left: 24px; top: 20px; flex-direction: row; align-items: center; }
.hud-money-icon { width: 36px; height: 26px; margin-right: 8px; }
.hud-wallet-amount { font-size: 28px; }

.hud-kit { position: absolute; left: 24px; bottom: 22px; align-items: flex-start; }
.hud-warning { margin-bottom: 6px; font-size: 15px; color: #a9f0e4; -unity-font: url("/Assets/Content/UI/Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-definition: initial; letter-spacing: 1px; }
.hud-kit-row { flex-direction: row; align-items: flex-end; }
.hud-counters { align-items: flex-start; margin-left: 10px; }
.hud-counter { flex-direction: row; align-items: center; margin-top: 6px; }
.hud-counter-icon { width: 22px; height: 22px; margin-right: 6px; }
.hud-counter.full .hud-number { color: #ffd45c; }

/* Battery: an upright rounded bar filling from the bottom, a bolt at its foot, coloured by the
   return estimate. */
.hud-battery { width: 20px; height: 130px; border-radius: 10px; overflow: hidden; background-color: rgba(12, 22, 26, 0.5); border-width: 1px; border-color: rgba(255, 255, 255, 0.16); }
.hud-charge { position: absolute; left: 0; right: 0; bottom: 0; border-radius: 10px; background-color: #6cc0b2; }
.hud-battery.risky .hud-charge { background-color: #f2bf45; }
.hud-battery.critical .hud-charge { background-color: #f0605a; }
.hud-battery.unlimited .hud-charge { background-color: #8ce0ff; }
.hud-bolt { position: absolute; left: 4px; bottom: 4px; width: 10px; height: 13px; }

.hud-admin { position: absolute; right: 24px; top: 24px; max-width: 38%; font-size: 15px; color: var(--muted); -unity-text-align: upper-right; white-space: normal; }
.hud-reticle {
    position: absolute;
    left: 50%; top: 50%;
    width: 30px; height: 30px;
    margin-left: -15px; margin-top: -15px;
    font-size: 24px; color: white;
    -unity-text-align: middle-center;
}
.hud-detector { position: absolute; right: 24px; bottom: 24px; width: 116px; padding: 10px 12px; background-color: rgba(19, 25, 31, 0.9); border-radius: 3px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.hud-detector-title { font-size: 12px; letter-spacing: 1px; color: var(--muted); margin-bottom: 6px; }
.hud-detector-strength { flex-direction: row; align-items: flex-end; height: 18px; }
.hud-detector-bar { flex-grow: 1; margin-right: 4px; background-color: #3e4851; }
.hud-detector-weak { height: 6px; }
.hud-detector-medium { height: 12px; }
.hud-detector-strong { height: 18px; margin-right: 0; }
.hud-detector-bar.active { background-color: var(--paper); }
.hud-target { position: absolute; left: 15%; right: 15%; top: 50%; margin-top: 32px; font-size: 19px; -unity-text-align: middle-center; white-space: normal; }
.hud-feedback { position: absolute; left: 15%; right: 15%; bottom: 78px; -unity-text-align: middle-center; white-space: normal; }
.hud-resource-warning-anchor { position: absolute; left: 15%; right: 15%; bottom: 24px; align-items: center; }
.hud-root .hud-resource-warning { padding: 7px 18px; margin: 4px 0 0; max-width: 100%; font-size: 21px; -unity-font-style: bold; letter-spacing: 1px; -unity-text-align: middle-center; white-space: normal; color: #ffd45c; background-color: rgba(19, 23, 26, 0.9); border-radius: 3px; }
.hud-root .hud-resource-warning.critical { color: #ff625c; }
.stacked-warnings .hud-feedback { bottom: 128px; }
