/* Menu screens: title, pause, settings and dialogs.

   Title and pause stand on the world: a sign-painted yellow logo and a large text menu
   over a soft wash from the left. Settings is a full-screen paper sheet: tabs along the
   top, rounded rows on the left (◀ value ▶ selectors with one pip per choice), the focused
   row's description on the right and the actions bottom right. Dialogs are a paper card.
   Station, inventory and admin keep the dark card from Theme.uss.

   Lilita One is the display face (logo, menu entries, tabs, headings, buttons); Barlow
   Condensed carries rows and running text. Sizes are in the panel's 1280 x 720 space. */

#menuRoot {
    --sign-yellow: #ffc933;
    --sign-ink: #2b1d0e;
    --cream: #fff3dc;
    --sheet: #e7d6b2;
    --sheet-bar: #a8956e;
    --sheet-tab: #b6a37c;
    --sheet-tab-on: #d0be98;
    --sheet-row: #f8ecd2;
    --sheet-row-hover: #fff5e2;
    --sheet-ink: #4f463c;
    --sheet-soft: #74695b;
    --sheet-line: #8d7c60;
    --sheet-faint: #d3c8b5;
    --sheet-mark: #ffe6b3;
    --sheet-key: #efe1c4;
    --sheet-dark: #6c6153;
}

/* ---------- type ---------- */
#menuRoot.title-screen, #menuRoot.pause-menu, #menuRoot.settings-menu, #menuRoot.dialog-menu {
    -unity-font: url("/Assets/Content/UI/Fonts/BarlowCondensed-Medium.ttf");
    -unity-font-definition: initial;
}
#menuRoot .logo-line,
#menuRoot.title-screen .startup-actions > .menu-button,
#menuRoot.pause-menu .pause-actions > .menu-button,
#menuRoot.pause-menu .title,
#menuRoot.pause-menu .section-title,
#menuRoot .settings-tab,
#menuRoot.settings-menu .setting-section,
#menuRoot .help-title,
#menuRoot .settings-footer > .menu-button,
#menuRoot.settings-menu .settings-error .menu-button,
#menuRoot.settings-menu .binding-conflict > .menu-button,
#menuRoot.dialog-menu .title,
#menuRoot.dialog-menu .footer > .menu-button {
    -unity-font: url("/Assets/Content/UI/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: initial;
    -unity-font-style: normal;
}
#menuRoot.settings-menu .preference-label,
#menuRoot .selector-value,
#menuRoot.settings-menu .range-value,
#menuRoot.settings-menu .setting-binding,
#menuRoot .help-option-text,
#menuRoot.pause-menu .key {
    -unity-font: url("/Assets/Content/UI/Fonts/BarlowCondensed-SemiBold.ttf");
    -unity-font-definition: initial;
    -unity-font-style: normal;
}

/* ---------- title ---------- */
.menu-scrim { position: absolute; left: 0; top: 0; bottom: 0; width: 64%; display: none; -unity-background-scale-mode: stretch-to-fill; }
#menuRoot.title-screen .menu-scrim, #menuRoot.pause-menu .menu-scrim { display: flex; }
#menuRoot.title-screen { background-color: transparent; }
#menuRoot.title-screen .menu-card { position: absolute; left: 0; top: 0; bottom: 0; width: 56%; max-width: none; max-height: none; padding: 30px 0 36px 44px; background-color: transparent; }
#menuRoot.title-screen .menu-header, #menuRoot.title-screen .subtitle { display: none; }
.title-logo { align-items: flex-start; flex-shrink: 0; margin: 0 0 60px -2px; rotate: -3deg; transform-origin: 0% 100%; }
.logo-line { margin: 0; padding: 0; white-space: nowrap; color: var(--sign-yellow); -unity-text-outline-width: 2px; -unity-text-outline-color: var(--sign-ink); text-shadow: 0 4px 0 var(--sign-ink); }
.logo-small { font-size: 36px; margin-left: 6px; letter-spacing: 1px; }
.logo-large { font-size: 76px; margin-top: -18px; }
.startup-note { margin: 14px 0 0 2px; font-size: 16px; color: rgba(255, 243, 220, 0.75); text-shadow: 0 2px 3px rgba(0, 0, 0, 0.5); }

/* Title and pause entries: plain words on the world, yellow and nudged right on hover. */
#menuRoot.title-screen .startup-actions, #menuRoot.pause-menu .pause-actions { width: 340px; flex-shrink: 0; }
#menuRoot.title-screen .startup-actions > .menu-button, #menuRoot.pause-menu .pause-actions > .menu-button {
    height: 46px; min-height: 0; margin: 0; padding: 0 0 0 2px; border-width: 0; border-radius: 0;
    font-size: 28px; -unity-text-align: middle-left; white-space: nowrap;
    color: var(--cream); background-color: transparent;
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(43, 29, 14, 0.7);
    text-shadow: 0 3px 4px rgba(0, 0, 0, 0.45);
    transition-property: translate, color; transition-duration: 0.12s;
}
#menuRoot.title-screen .startup-actions > .menu-button:hover,
#menuRoot.title-screen.keyboard-navigation .startup-actions > .menu-button:focus,
#menuRoot.pause-menu .pause-actions > .menu-button:hover,
#menuRoot.pause-menu.keyboard-navigation .pause-actions > .menu-button:focus { color: var(--sign-yellow); background-color: transparent; translate: 10px 0; }
#menuRoot.title-screen .startup-actions > .menu-button:active,
#menuRoot.pause-menu .pause-actions > .menu-button:active { color: #ffe08a; background-color: transparent; }
#menuRoot.title-screen .startup-actions > .menu-button:disabled,
#menuRoot.pause-menu .pause-actions > .menu-button:disabled { color: rgba(255, 243, 220, 0.38); background-color: transparent; translate: 0 0; opacity: 1; }

.menu-version { position: absolute; left: 0; right: 0; bottom: 4px; display: none; -unity-text-align: middle-center; font-size: 10px; color: rgba(255, 243, 220, 0.6); }
#menuRoot.title-screen .menu-version { display: flex; }
#menuRoot.settings-menu .menu-version { display: flex; color: rgba(79, 70, 60, 0.55); }

/* ---------- pause ---------- */
#menuRoot.pause-menu { background-color: rgba(8, 6, 4, 0.3); }
#menuRoot.pause-menu .menu-card { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; max-width: none; max-height: none; padding: 0 44px; justify-content: center; background-color: transparent; }
#menuRoot.pause-menu .menu-header { margin-bottom: 24px; }
#menuRoot.pause-menu .title { flex-grow: 0; font-size: 60px; color: var(--sign-yellow); -unity-text-outline-width: 2px; -unity-text-outline-color: var(--sign-ink); text-shadow: 0 4px 0 var(--sign-ink); rotate: -3deg; transform-origin: 0% 100%; }
.pause-columns { flex-direction: row; align-items: flex-start; }
#menuRoot.pause-menu .pause-actions { margin-right: 48px; }
.controls-card { width: 330px; padding: 18px 22px 10px; border-radius: 18px; background-color: rgba(248, 236, 210, 0.95); }
#menuRoot.pause-menu .section-title { font-size: 20px; letter-spacing: 3px; color: var(--sheet-ink); margin-bottom: 12px; }
.control-line { flex-direction: row; align-items: center; margin-bottom: 8px; }
.key { width: 118px; flex-shrink: 0; margin: 0 14px 0 0; padding: 2px 8px; border-radius: 6px; background-color: var(--sheet-key); color: var(--sheet-ink); font-size: 15px; -unity-text-align: middle-center; white-space: normal; }
.control-description { flex-grow: 1; flex-basis: 0; min-width: 0; font-size: 16px; color: var(--sheet-soft); white-space: normal; }
#menuRoot.pause-menu .notice { color: var(--cream); text-shadow: 0 2px 3px rgba(0, 0, 0, 0.5); }

/* ---------- settings sheet ---------- */
#menuRoot.settings-menu { background-color: var(--sheet); }
#menuRoot.settings-menu .menu-card { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; height: auto; max-width: none; max-height: none; padding: 0; background-color: var(--sheet); color: var(--sheet-ink); }
#menuRoot.settings-menu .menu-header, #menuRoot.settings-menu .subtitle { display: none; }

.settings-tabs { flex-direction: row; justify-content: center; align-items: center; flex-shrink: 0; height: 56px; padding: 0 24px; background-color: var(--sheet-bar); }
#menuRoot .settings-tab { height: 38px; min-height: 0; min-width: 96px; margin: 0 4px; padding: 0 20px; border-width: 2px; border-radius: 14px; border-color: #9a875f; background-color: var(--sheet-tab); color: #5e5346; font-size: 17px; letter-spacing: 4px; }
#menuRoot .settings-tab:hover { background-color: #c3b08a; border-color: #9a875f; color: var(--sheet-ink); }
#menuRoot .settings-tab:active { background-color: #cbb994; }
#menuRoot .settings-tab.selected-tab { background-color: var(--sheet-tab-on); border-color: #e4d6b6; color: var(--sheet-ink); }
#menuRoot.keyboard-navigation .settings-tab:focus { border-color: var(--sheet-ink); }
#menuRoot .settings-tab:disabled { background-color: var(--sheet-tab); border-color: #9a875f; color: #857862; opacity: 0.7; }

#menuRoot.settings-menu .settings-page { position: absolute; left: 44px; top: 62px; bottom: 60px; width: 54%; }
.settings-help { position: absolute; left: 61%; right: 44px; top: 84px; bottom: 70px; }
.settings-footer { position: absolute; right: 22px; bottom: 16px; flex-direction: row; align-items: center; }

#menuRoot.settings-menu .settings-scroll .unity-scroll-view__content-container { padding-right: 22px; }
#menuRoot.settings-menu .unity-scroller--vertical .unity-base-slider__tracker { left: 2px; width: 4px; border-radius: 2px; background-color: #d6cab2; }
#menuRoot.settings-menu .unity-scroller--vertical .unity-base-slider__dragger { left: 1px; width: 6px; border-radius: 3px; background-color: var(--sheet-line); }

#menuRoot.settings-menu .setting-section { margin: 16px 0 12px 6px; font-size: 26px; letter-spacing: 6px; color: #5e5346; }

#menuRoot.settings-menu .preference-row { height: 44px; min-height: 44px; padding: 0 14px 0 26px; margin-bottom: 8px; border-width: 2px; border-radius: 22px; border-color: transparent; background-color: var(--sheet-row); }
#menuRoot.settings-menu .preference-row:hover { background-color: var(--sheet-row-hover); }
#menuRoot.settings-menu .focused-row { border-color: var(--sheet-line); }
#menuRoot.settings-menu .preference-label { margin-right: 16px; font-size: 18px; letter-spacing: 3px; color: var(--sheet-ink); }
#menuRoot.settings-menu .disabled-row .preference-label { color: #a39782; }

/* ◀ value ▶ with pips beneath */
.setting-selector { flex-direction: row; align-items: center; width: 264px; height: 40px; flex-shrink: 0; }
.selector-arrow { width: 32px; height: 32px; flex-shrink: 0; border-radius: 16px; color: var(--sheet-ink); }
.selector-arrow:hover { background-color: rgba(141, 124, 96, 0.2); }
.selector-arrow:active { background-color: rgba(141, 124, 96, 0.35); }
.setting-selector:disabled .selector-arrow { opacity: 0.25; }
.selector-middle { flex-grow: 1; height: 100%; align-items: center; justify-content: center; }
.selector-value { margin: 0; padding: 0; font-size: 19px; letter-spacing: 1px; white-space: nowrap; -unity-text-align: middle-center; color: var(--sheet-ink); }
.setting-selector:disabled .selector-value { color: #a39782; }
.selector-pips { flex-direction: row; justify-content: center; width: 150px; height: 4px; margin-top: 5px; }
.selector-pip { flex-grow: 1; max-width: 26px; height: 4px; margin: 0 2px; border-radius: 2px; background-color: var(--sheet-faint); }
.selector-pip-on { background-color: var(--sheet-dark); }
.selector-track { border-radius: 2px; background-color: var(--sheet-faint); }
.selector-marker { position: absolute; top: 0; bottom: 0; border-radius: 2px; background-color: var(--sheet-dark); }
.setting-selector:disabled .selector-pip-on, .setting-selector:disabled .selector-marker { background-color: #b9ad98; }

#menuRoot.settings-menu .setting-binding { width: 264px; height: 32px; min-height: 0; margin: 0; padding: 0 12px; border-width: 2px; border-radius: 10px; border-color: #c9b994; background-color: var(--sheet-key); color: var(--sheet-ink); font-size: 18px; letter-spacing: 1px; -unity-text-align: middle-center; }
#menuRoot.settings-menu .setting-binding:hover { background-color: #f6ead2; border-color: var(--sheet-line); color: var(--sheet-ink); }
#menuRoot.settings-menu .setting-binding:active { background-color: var(--sheet-mark); }
#menuRoot.settings-menu .setting-binding:disabled { background-color: var(--sheet-key); border-color: #d8ccb2; color: #a39782; opacity: 1; }
#menuRoot.settings-menu .setting-binding.binding-selected, #menuRoot.settings-menu .setting-binding.binding-selected:disabled { background-color: var(--sheet-mark); border-color: var(--sheet-line); color: var(--sheet-ink); }

#menuRoot.settings-menu .setting-range { width: 264px; height: 40px; min-height: 0; justify-content: center; color: var(--sheet-ink); }
#menuRoot.settings-menu .range-value { width: 66px; height: 30px; margin: 0 12px 0 0; font-size: 19px; color: var(--sheet-ink); -unity-text-align: middle-right; }
#menuRoot.settings-menu .setting-slider { width: 170px; }
#menuRoot.settings-menu .setting-slider .unity-base-slider__tracker { top: 11px; height: 8px; border-radius: 4px; background-color: var(--sheet-faint); }
#menuRoot.settings-menu .setting-slider .unity-base-slider__dragger { top: 5px; width: 20px; height: 20px; border-radius: 10px; background-color: var(--sheet-dark); }
#menuRoot.settings-menu .setting-slider:enabled:hover .unity-base-slider__tracker { background-color: #cbbfa9; }

/* description of the focused row */
.help-title { margin: 4px 0 14px; padding: 0; font-size: 26px; letter-spacing: 5px; white-space: normal; color: #5e5346; }
.help-text { margin: 0 0 18px; padding: 0; font-size: 17px; letter-spacing: 0.5px; white-space: normal; color: var(--sheet-soft); }
.help-options { align-items: flex-start; }
.help-option { flex-direction: row; align-items: center; height: 32px; min-width: 210px; padding: 0 14px 0 12px; border-radius: 4px; }
.help-option-current { background-color: var(--sheet-mark); }
.help-bullet { width: 8px; height: 8px; margin-right: 12px; background-color: var(--sheet-dark); }
.help-option-text { margin: 0; padding: 0; font-size: 19px; color: var(--sheet-ink); }

#menuRoot .settings-footer > .menu-button { height: 38px; min-height: 0; min-width: 116px; margin: 0 0 0 10px; padding: 0 22px; border-width: 2px; border-radius: 19px; border-color: transparent; background-color: var(--sheet-row); color: var(--sheet-ink); font-size: 18px; letter-spacing: 3px; }
#menuRoot .settings-footer > .menu-button:hover { background-color: var(--sheet-row-hover); border-color: #c9b994; color: var(--sheet-ink); }
#menuRoot .settings-footer > .menu-button:active { background-color: var(--sheet-mark); }
#menuRoot.keyboard-navigation .settings-footer > .menu-button:focus { border-color: var(--sheet-line); }
#menuRoot .settings-footer > .menu-button:disabled { background-color: var(--sheet-row); border-color: transparent; color: #b0a48f; opacity: 0.7; }

#menuRoot.settings-menu .caption, #menuRoot.settings-menu .notice { font-size: 17px; color: var(--sheet-soft); }
#menuRoot.settings-menu .settings-error .menu-button, #menuRoot.settings-menu .binding-conflict > .menu-button { width: auto; height: 34px; min-height: 0; padding: 0 18px; border-width: 2px; border-radius: 17px; border-color: #c9b994; background-color: var(--sheet-row); color: var(--sheet-ink); font-size: 16px; letter-spacing: 2px; }
#menuRoot.settings-menu .settings-error .menu-button:hover, #menuRoot.settings-menu .binding-conflict > .menu-button:hover { background-color: var(--sheet-row-hover); border-color: var(--sheet-line); }
#menuRoot.settings-menu .binding-conflict > .primary { background-color: #5a4b38; border-color: #5a4b38; color: var(--cream); }
#menuRoot.settings-menu .binding-conflict > .primary:hover { background-color: #6b5a43; border-color: #6b5a43; }
#menuRoot.settings-menu.keyboard-navigation .settings-error .menu-button:focus, #menuRoot.settings-menu.keyboard-navigation .binding-conflict > .menu-button:focus { border-color: var(--sheet-ink); }

/* ---------- dialogs ---------- */
#menuRoot.dialog-menu { background-color: rgba(10, 7, 4, 0.6); }
#menuRoot.dialog-menu .menu-card { width: 500px; height: auto; padding: 28px 32px 26px; border-width: 3px; border-radius: 24px; border-color: #dcc9a0; background-color: var(--sheet-row); color: var(--sheet-ink); }
#menuRoot.dialog-menu .menu-header { margin-bottom: 14px; }
#menuRoot.dialog-menu .title { font-size: 32px; color: var(--sheet-ink); }
#menuRoot.dialog-menu .subtitle { display: none; }
#menuRoot.dialog-menu .body { font-size: 19px; color: var(--sheet-soft); }
#menuRoot.dialog-menu .content-scroll { max-height: 300px; }
#menuRoot.dialog-menu .footer { margin-top: 20px; }
#menuRoot.dialog-menu .footer > .menu-button { height: 40px; min-height: 0; padding: 0 22px; border-width: 2px; border-radius: 20px; border-color: #c9b994; background-color: var(--sheet-key); color: var(--sheet-ink); font-size: 18px; letter-spacing: 1px; }
#menuRoot.dialog-menu .footer > .menu-button:hover { background-color: #f6ead2; border-color: var(--sheet-line); color: var(--sheet-ink); }
#menuRoot.dialog-menu .footer > .primary { background-color: #5a4b38; border-color: #5a4b38; color: var(--cream); }
#menuRoot.dialog-menu .footer > .primary:hover { background-color: #6b5a43; border-color: #6b5a43; color: var(--cream); }
#menuRoot.dialog-menu.keyboard-navigation .footer > .menu-button:focus { border-color: var(--sheet-ink); }

/* Window lost focus: nothing drawn over the paused world (see Theme.uss). */
#menuRoot.focus-pause { background-color: transparent; }
#menuRoot.focus-pause .menu-scrim, #menuRoot.focus-pause .menu-card, #menuRoot.focus-pause .menu-version { display: none; }
