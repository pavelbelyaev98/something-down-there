/* Screen layouts: title, pause, settings and dialogs (palette and type in Theme.uss, buttons
   and rows in Controls.uss).

   Title and pause share one layout on the world: a left-aligned column, the stacked orange
   logo at the top and the menu a short way under it; the entries are plain words that only
   change colour on hover. Settings is a full-screen slate sheet: tabs along the top, rows on
   the left, the focused row's description on the right, actions bottom right. Dialogs are
   the slate card at a fixed width. */

/* ---------- title and pause ---------- */
.menu-scrim { position: absolute; left: 0; top: 0; bottom: 0; width: 56%; display: none; -unity-background-scale-mode: stretch-to-fill; }
#menuRoot.title-screen .menu-scrim, #menuRoot.pause-menu .menu-scrim { display: flex; }
#menuRoot.title-screen { background-color: transparent; }
#menuRoot.pause-menu { background-color: rgba(10, 14, 16, 0.35); }
#menuRoot.title-screen .menu-card, #menuRoot.pause-menu .menu-card { position: absolute; left: 60px; top: 0; bottom: 0; width: 420px; max-width: none; max-height: none; padding: 44px 0 0; border-radius: 0; justify-content: flex-start; align-items: flex-start; background-color: transparent; }
#menuRoot.title-screen .menu-header, #menuRoot.title-screen .subtitle, #menuRoot.pause-menu .menu-header, #menuRoot.pause-menu .subtitle { display: none; }
.title-logo { align-items: flex-start; flex-shrink: 0; }
.logo-line { margin: 0; padding: 0; white-space: nowrap; -unity-text-align: middle-left; color: var(--orange); -unity-text-outline-color: var(--ink); -unity-text-outline-width: 3px; text-shadow: 0 5px 0 var(--ink); }
.logo-small { font-size: 66px; letter-spacing: 1px; }
.logo-large { font-size: 108px; margin-top: -30px; }
#menuRoot.title-screen #startupPage, #menuRoot.pause-menu #pausePage { align-items: flex-start; margin-top: 48px; }
.startup-note { margin: 10px 0 0; font-size: 16px; -unity-text-align: middle-left; color: rgba(243, 238, 228, 0.8); text-shadow: 0 2px 3px rgba(0, 0, 0, 0.5); }
#menuRoot.pause-menu .notice { -unity-text-align: middle-left; text-shadow: 0 2px 3px rgba(0, 0, 0, 0.5); }

#menuRoot.title-screen .startup-actions, #menuRoot.pause-menu .pause-actions { width: 380px; flex-shrink: 0; }
#menuRoot.title-screen .startup-actions > .menu-button, #menuRoot.pause-menu .pause-actions > .menu-button {
    height: 44px; margin: 0; padding: 0; border-width: 0; border-radius: 0;
    font-size: 27px; -unity-text-align: middle-left;
    color: var(--bone); background-color: transparent;
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(27, 38, 44, 0.8);
    text-shadow: 0 3px 4px rgba(0, 0, 0, 0.45);
    transition-property: color; transition-duration: 0.12s;
}
#menuRoot.title-screen .startup-actions > .menu-button:hover,
#menuRoot.title-screen.keyboard-navigation .startup-actions > .menu-button:focus,
#menuRoot.pause-menu .pause-actions > .menu-button:hover,
#menuRoot.pause-menu.keyboard-navigation .pause-actions > .menu-button:focus { color: var(--orange); background-color: transparent; }
#menuRoot.title-screen .startup-actions > .menu-button:active,
#menuRoot.pause-menu .pause-actions > .menu-button:active { color: var(--orange-hover); background-color: transparent; }
#menuRoot.title-screen .startup-actions > .menu-button:disabled,
#menuRoot.pause-menu .pause-actions > .menu-button:disabled { color: rgba(243, 238, 228, 0.36); background-color: transparent; opacity: 1; }

.menu-version { position: absolute; left: 0; right: 0; bottom: 4px; display: none; -unity-text-align: middle-center; font-size: 10px; color: rgba(243, 238, 228, 0.6); }
#menuRoot.title-screen .menu-version, #menuRoot.settings-menu .menu-version { display: flex; }

/* ---------- settings sheet ---------- */
#menuRoot.settings-menu { background-color: var(--slate-800); }
#menuRoot.settings-menu .menu-card { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; height: auto; max-width: none; max-height: none; padding: 0; border-radius: 0; }
#menuRoot.settings-menu .menu-header, #menuRoot.settings-menu .subtitle { display: none; }

.settings-tabs { flex-direction: row; justify-content: center; align-items: center; flex-shrink: 0; height: 56px; padding: 0 24px; background-color: var(--slate-900); }
.settings-tab { height: 36px; min-width: 96px; margin: 0 4px; padding: 0 20px; font-size: 16px; letter-spacing: 4px; }
#menuRoot .settings-tab { color: var(--bone-soft); }
#menuRoot .settings-tab.selected-tab { color: var(--on-primary); }

#menuRoot.settings-menu .settings-page { position: absolute; left: 44px; top: 62px; bottom: 60px; width: 54%; }
.settings-help { position: absolute; left: 61%; right: 44px; top: 84px; bottom: 70px; }
.settings-footer { position: absolute; right: 22px; bottom: 16px; flex-direction: row; align-items: center; }
.settings-footer > .menu-button { min-width: 116px; margin: 0 0 0 10px; padding: 0 22px; font-size: 17px; letter-spacing: 3px; }

/* the focused row's description */
.help-title { margin: 4px 0 14px; padding: 0; font-size: 26px; letter-spacing: 5px; white-space: normal; color: var(--orange); }
.help-text { margin: 0 0 18px; padding: 0; font-size: 17px; letter-spacing: 0.5px; white-space: normal; color: var(--bone-soft); }
.help-options { align-items: flex-start; }
.help-option { flex-direction: row; align-items: center; height: 32px; min-width: 210px; padding: 0 14px; border-radius: 6px; }
.help-option-current { background-color: var(--slate-700); }
.help-bullet { width: 6px; height: 6px; margin-right: 12px; background-color: var(--bone-faint); }
.help-option-current .help-bullet { background-color: var(--orange); }
.help-option-text { margin: 0; padding: 0; font-size: 19px; color: var(--bone); }

/* ---------- dialogs ---------- */
#menuRoot.dialog-menu .menu-card { width: 500px; height: auto; }
#menuRoot.dialog-menu .subtitle { display: none; }
#menuRoot.dialog-menu .content-scroll { max-height: 300px; }

/* Window lost focus: nothing drawn over the paused world (see Theme.uss). */
#menuRoot.focus-pause { background-color: transparent; }
#menuRoot.focus-pause .menu-scrim, #menuRoot.focus-pause .menu-card, #menuRoot.focus-pause .menu-version { display: none; }
