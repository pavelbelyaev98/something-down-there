<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Theme.uss" />
    <ui:Style src="Hud.uss" />
    <ui:VisualElement name="hudRoot" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement class="hud-resources">
            <ui:VisualElement name="batteryGroup" class="hud-battery">
                <ui:Label name="Battery status" />
                <ui:VisualElement class="hud-charge-track"><ui:VisualElement name="Charge" class="hud-charge" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-inventory">
                <ui:Label name="Status" />
                <ui:Label name="Wallet" class="hud-secondary" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="Shovel status" class="hud-equipment" />
        <ui:Label name="Return warning" class="hud-warning" />
        <ui:Label name="Developer controls" class="hud-admin" />
        <ui:Label name="Reticle" text="+" class="hud-reticle" />
        <ui:VisualElement name="DetectorPanel" class="hud-detector hidden" picking-mode="Ignore">
            <ui:Label text="DETECTOR" class="hud-detector-title" />
            <ui:VisualElement class="hud-detector-strength">
                <ui:VisualElement name="DetectorBar1" class="hud-detector-bar hud-detector-weak" />
                <ui:VisualElement name="DetectorBar2" class="hud-detector-bar hud-detector-medium" />
                <ui:VisualElement name="DetectorBar3" class="hud-detector-bar hud-detector-strong" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="Target" class="hud-target" />
        <ui:Label name="Feedback" class="hud-feedback" />
        <ui:VisualElement class="hud-resource-warning-anchor" picking-mode="Ignore">
            <ui:Label name="Inventory warning" text="INVENTORY FULL" class="hud-resource-warning hidden" picking-mode="Ignore" />
            <ui:Label name="Fuel warning" class="hud-resource-warning hidden" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
