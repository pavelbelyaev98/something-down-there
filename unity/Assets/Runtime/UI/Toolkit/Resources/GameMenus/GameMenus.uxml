<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Theme.uss" />
    <ui:Style src="Controls.uss" />
    <ui:Style src="Station.uss" />
    <ui:VisualElement name="menuRoot" class="menu-root hidden">
        <ui:VisualElement name="menuCard" class="menu-card">
            <ui:VisualElement class="menu-header">
                <ui:Label name="menuTitle" text="Paused" class="title" />
            </ui:VisualElement>
            <ui:Label name="menuSubtitle" class="subtitle" />
            <ui:VisualElement name="settingsNavigation" class="settings-tabs hidden">
                <ui:Button name="settingsDisplay" text="Display" class="menu-button settings-tab" />
                <ui:Button name="settingsGraphics" text="Graphics" class="menu-button settings-tab" />
                <ui:Button name="settingsAudio" text="Audio" class="menu-button settings-tab" />
                <ui:Button name="settingsControls" text="Controls" class="menu-button settings-tab" />
                <ui:Button name="settingsAccessibility" text="Accessibility" class="menu-button settings-tab" />
            </ui:VisualElement>
            <ui:VisualElement name="startupPage" class="hidden">
                <ui:VisualElement name="startupActions" class="startup-actions" />
                <ui:Label name="startupNote" class="caption startup-note" />
            </ui:VisualElement>
            <ui:VisualElement name="pausePage" class="hidden">
                <ui:VisualElement class="pause-columns">
                    <ui:VisualElement name="pauseActions" class="pause-actions" />
                    <ui:VisualElement class="controls-card">
                        <ui:Label text="Controls" class="section-title" />
                        <ui:VisualElement class="control-line"><ui:Label name="controlMove" class="key" /><ui:Label text="Move" class="control-description" /></ui:VisualElement>
                        <ui:VisualElement class="control-line"><ui:Label name="controlSprint" class="key" /><ui:Label text="Sprint (hold)" class="control-description" /></ui:VisualElement>
                        <ui:VisualElement class="control-line"><ui:Label name="controlCrouch" class="key" /><ui:Label text="Crouch (hold)" class="control-description" /></ui:VisualElement>
                        <ui:VisualElement class="control-line"><ui:Label text="MOUSE" class="key" /><ui:Label text="Look" class="control-description" /></ui:VisualElement>
                        <ui:VisualElement class="control-line"><ui:Label name="controlDig" class="key" /><ui:Label name="controlDigDescription" class="control-description" /></ui:VisualElement>
                        <ui:VisualElement class="control-line"><ui:Label name="controlJump" class="key" /><ui:Label text="Jump / jetpack" class="control-description" /></ui:VisualElement>
                        <ui:VisualElement class="control-line"><ui:Label name="controlInteract" class="key" /><ui:Label text="Interact / inventory" class="control-description" /></ui:VisualElement>
                        <ui:VisualElement class="control-line"><ui:Label name="controlPause" class="key" /><ui:Label text="Pause" class="control-description" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="pauseSettingsError" class="notice hidden" text="Camera settings not saved. Retry in Accessibility." />
                <ui:Label name="pauseInputError" class="notice hidden" text="Controls not saved. Retry in Settings." />
                <ui:Label name="pauseDeviceError" class="notice hidden" text="Settings not saved. Retry in Settings." />
            </ui:VisualElement>
            <ui:VisualElement name="cameraPage" class="settings-page hidden">
                <ui:ScrollView name="cameraScroll" mode="Vertical" class="content-scroll settings-scroll" horizontal-scroller-visibility="Hidden" />
                <ui:VisualElement name="settingsError" class="settings-error hidden"><ui:Label text="Not saved. Active for this session." class="caption" /><ui:Button name="settingsRetry" text="Retry" class="menu-button" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="inputPage" class="settings-page input-page hidden">
                <ui:ScrollView name="bindingScroll" mode="Vertical" class="content-scroll settings-scroll binding-scroll" horizontal-scroller-visibility="Hidden" />
                <ui:Label name="bindingNotice" class="notice binding-notice" />
                <ui:VisualElement name="bindingConflict" class="binding-conflict hidden"><ui:Button name="bindingCancel" text="Cancel" class="menu-button" /><ui:Button name="bindingReplace" text="Swap bindings" class="menu-button primary" /></ui:VisualElement>
                <ui:VisualElement name="inputSettingsError" class="settings-error hidden"><ui:Label text="Not saved. Active for this session." class="caption" /><ui:Button name="inputRetry" text="Retry" class="menu-button" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="devicePage" class="settings-page hidden">
                <ui:ScrollView name="deviceScroll" mode="Vertical" class="content-scroll settings-scroll" horizontal-scroller-visibility="Hidden" />
                <ui:VisualElement name="deviceError" class="settings-error hidden"><ui:Label text="Not saved. Active for this session." class="caption" /><ui:Button name="deviceRetry" text="Retry" class="menu-button" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="settingsFooter" class="settings-footer hidden">
                <ui:Button name="settingsBack" text="Back" class="menu-button" />
                <ui:Button name="cameraReset" text="Reset category" class="menu-button" />
                <ui:Button name="inputReset" text="Reset category" class="menu-button" />
                <ui:Button name="deviceReset" text="Reset category" class="menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="contentPage" class="content-page hidden">
                <ui:VisualElement name="tradeSummary" class="trade-summary hidden" />
                <ui:ScrollView name="menuScroll" mode="Vertical" class="content-scroll" horizontal-scroller-visibility="Hidden" />
                <ui:VisualElement name="menuActions" class="footer" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label name="FpsReadout" class="fps-readout hidden" picking-mode="Ignore" />
</ui:UXML>
