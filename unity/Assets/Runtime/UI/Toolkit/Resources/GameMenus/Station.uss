/* Station machines: one board in the menus' slate, bone and orange (Screens.uss). The header
   carries only the balance. The workshop is one list of roomy tiles: the four equipment
   tracks (name, a progress bar, the one number the purchase changes) and then the services.

   Rows are decoration, never interactive: only the price button inside a row has
   hover, pressed and focus states, and only it can be clicked.

   Tile:
     [icon] NAME ...................... price button
            progress bar
            what the purchase changes
*/

#menuRoot.station-menu {
    -unity-font: url("/Assets/Content/UI/Fonts/BarlowCondensed-Medium.ttf");
    -unity-font-definition: initial;
    background-color: rgba(10, 14, 16, 0.45);
}
#menuRoot.station-menu .station-cell-name,
#menuRoot.station-menu .trade-balance,
#menuRoot.station-menu .station-price,
#menuRoot.station-menu .station-sell-value,
#menuRoot.station-menu .footer > .menu-button {
    -unity-font: url("/Assets/Content/UI/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: initial;
    -unity-font-style: normal;
}
#menuRoot.station-menu .station-cell-effect,
#menuRoot.station-menu .station-sell-name,
#menuRoot.station-menu .station-money-caption {
    -unity-font: url("/Assets/Content/UI/Fonts/BarlowCondensed-SemiBold.ttf");
    -unity-font-definition: initial;
    -unity-font-style: normal;
}

.station-menu .menu-card { width: 600px; height: 380px; padding: 0; overflow: hidden; border-width: 0; border-radius: 12px; background-color: var(--slate-800); }
.workshop-menu .menu-card { height: 648px; }
.station-menu .menu-header { display: none; }
.station-menu .subtitle { display: none; }
.station-menu .content-page { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.station-menu .trade-summary { flex-shrink: 0; }
.station-menu .content-scroll { max-height: none; flex-grow: 1; min-height: 0; }
.station-menu .footer { margin: 0; padding: 6px 20px 20px; }

/* ---------- header plate: the balance ---------- */
.station-bar-head { flex-direction: row; align-items: center; justify-content: center; height: 60px; background-color: var(--slate-900); }
.station-money { flex-direction: row; align-items: center; }
#menuRoot.station-menu .station-money-caption { margin: 4px 12px 0 0; font-size: 16px; letter-spacing: 4px; color: var(--bone-soft); }
#menuRoot.station-menu .trade-balance { padding: 0; margin: 0; font-size: 30px; color: var(--bone); background-color: transparent; }

/* ---------- tiles: decoration only, no interaction states ---------- */
.station-list { padding: 20px 20px 12px; }
.station-row { flex-direction: row; align-items: center; margin: 0 0 8px; padding: 12px 16px 12px 12px; border-width: 0; border-radius: 10px; background-color: var(--slate-700); background-image: none; }
.station-row-main { flex-direction: column; flex-grow: 1; flex-basis: 0; min-width: 0; }
/* The icon sits on a bone tile: the set's dark outlines vanish on slate. */
.station-icon-tile { width: 54px; height: 54px; margin-right: 16px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 10px; background-color: var(--bone); }
.station-icon-tile > .icon { width: 42px; height: 42px; }
#menuRoot.station-menu .station-cell-name { margin: 0; padding: 0; font-size: 19px; letter-spacing: 1px; color: var(--bone); white-space: nowrap; -unity-text-align: middle-left; }
.station-progress { height: 6px; margin: 7px 0 6px; border-radius: 3px; overflow: hidden; background-color: var(--slate-line); }
.station-progress-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: var(--orange); }
#menuRoot.station-menu .station-cell-effect { margin: 0; padding: 0; font-size: 16px; letter-spacing: 0.5px; color: var(--bone-soft); white-space: nowrap; -unity-text-align: middle-left; }

/* Services: no progress; the name and what it gives on two lines. */
.station-row.service { background-color: var(--slate-600); }
#menuRoot.station-menu .station-row.service .station-cell-effect { margin-top: 4px; }

/* ---------- the only clickable thing: the price button ---------- */
#menuRoot .station-price { width: 92px; min-width: 92px; height: 42px; min-height: 0; flex-shrink: 0; margin: 0 0 0 20px; padding: 0; font-size: 20px; -unity-text-align: middle-center; border-width: 2px; border-color: transparent; border-radius: 8px; background-color: var(--orange); background-image: none; color: var(--ink); }
#menuRoot .station-price:hover { background-color: var(--orange-hover); color: var(--ink); }
#menuRoot .station-price:active { background-color: var(--bone); }
#menuRoot.keyboard-navigation .station-price:focus { border-color: var(--bone); }
#menuRoot .station-price.just-bought { background-color: var(--bone); color: var(--ink); }

/* cannot buy (out of reach, finished track, full tank): reads as disabled and has
   no hover or pressed reaction at all */
#menuRoot .station-price.short, #menuRoot .station-price.maxed, #menuRoot .station-price:disabled,
#menuRoot .station-price.short:hover, #menuRoot .station-price.maxed:hover, #menuRoot .station-price:disabled:hover {
    background-color: var(--slate-500); color: var(--bone-faint); border-color: transparent; opacity: 1;
}

/* ---------- sell rows: one line, name left and payout button right ---------- */
.station-table { flex-direction: column; padding: 20px 20px 12px; }
.station-sell-row { flex-direction: row; align-items: center; margin: 0 0 10px; padding: 10px 12px 10px 20px; border-width: 0; border-radius: 10px; background-color: var(--slate-700); background-image: none; }
#menuRoot.station-menu .station-sell-name { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0; padding: 0; font-size: 19px; color: var(--bone); white-space: nowrap; -unity-text-align: middle-left; }
#menuRoot .station-sell-value { min-width: 120px; height: 36px; min-height: 0; flex-shrink: 0; margin: 0 0 0 20px; padding: 0 12px; font-size: 18px; -unity-text-align: middle-center; border-width: 2px; border-color: transparent; border-radius: 8px; background-color: var(--slate-500); background-image: none; color: var(--bone); }
#menuRoot .station-sell-value:hover { background-color: var(--orange); color: var(--ink); }
#menuRoot .station-sell-value:disabled, #menuRoot .station-sell-value:disabled:hover { background-color: var(--slate-500); color: var(--bone-faint); opacity: 1; }
#menuRoot.keyboard-navigation .station-sell-value:focus { border-color: var(--bone); }
#menuRoot.station-menu .station-empty { padding: 24px 0; -unity-text-align: middle-center; white-space: normal; font-size: 19px; color: var(--bone-soft); }

#menuRoot.station-menu .footer > .menu-button { flex-grow: 1; flex-basis: 0; max-width: none; height: 44px; min-height: 0; margin: 0; border-width: 2px; border-radius: 8px; font-size: 20px; letter-spacing: 1px; }
#menuRoot.station-menu.keyboard-navigation .footer > .menu-button:focus { border-color: var(--bone); }
