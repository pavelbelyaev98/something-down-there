/* Station machines (palette, type and the find rows in Theme.uss). The header carries only the
   balance. Selling lists carried finds one row per kind with a single Sell all. The workshop
   has two columns of roomy tiles: UPGRADES, the four equipment tracks (name, a progress bar,
   the one number the purchase changes), and SUPPLIES, the recharge and the work lamp.

   Tiles are decoration, never interactive: only the price button inside one has hover, press
   and focus states, and only it can be clicked.

   Tile:
     [icon] NAME ...................... price button
            progress bar
            what the purchase changes
*/

#menuRoot.station-menu { background-color: rgba(10, 14, 16, 0.45); }
.station-menu .menu-card { width: 600px; height: 380px; padding: 0; overflow: hidden; }
.workshop-menu .menu-card { width: 940px; height: 512px; }
.station-menu .menu-header { display: none; }
.station-menu .subtitle { display: none; }
.station-menu .content-page { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.station-menu .content-scroll { max-height: none; flex-grow: 1; min-height: 0; }
.station-menu .footer { margin: 0; padding: 6px 20px 20px; }
.station-menu .footer > .menu-button { flex-grow: 1; flex-basis: 0; max-width: none; height: 46px; margin: 0; font-size: 20px; }

/* ---------- header plate: the balance ---------- */
.station-bar-head { flex-direction: row; align-items: center; justify-content: center; height: 60px; background-color: var(--slate-900); }
.station-money { flex-direction: row; align-items: center; }
.station-money-caption { margin: 4px 12px 0 0; font-size: 16px; letter-spacing: 4px; color: var(--bone-soft); }
.station-menu .trade-balance { padding: 0; margin: 0; font-size: 30px; color: var(--bone); background-color: transparent; }

/* ---------- selling: carried finds, one row per kind ---------- */
.station-table { flex-direction: column; padding: 20px 20px 12px; }

/* ---------- workshop columns ---------- */
.station-columns { flex-direction: row; align-items: flex-start; padding: 18px 20px 10px; }
.station-column { flex-direction: column; align-items: stretch; flex-grow: 3; flex-basis: 0; min-width: 0; }
.station-supplies { flex-grow: 2; margin-left: 18px; }
.station-column-heading { margin: 0 0 10px 4px; padding: 0; font-size: 15px; letter-spacing: 4px; color: var(--bone-faint); }

/* ---------- tiles: decoration only, no interaction states ---------- */
.station-row { flex-direction: row; align-items: center; margin: 0 0 8px; padding: 12px 16px 12px 12px; border-radius: 10px; background-color: var(--slate-700); }
.station-row-main { flex-direction: column; flex-grow: 1; flex-basis: 0; min-width: 0; }
/* The icon sits on a bone tile: the set's dark outlines vanish on slate. */
.station-icon-tile { width: 54px; height: 54px; margin-right: 16px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 10px; background-color: var(--bone); }
.station-icon-tile > .icon { width: 42px; height: 42px; }
.station-cell-name { margin: 0; padding: 0; font-size: 19px; letter-spacing: 1px; color: var(--bone); white-space: nowrap; -unity-text-align: middle-left; }
.station-progress { height: 6px; margin: 7px 0 6px; border-radius: 3px; overflow: hidden; background-color: var(--slate-line); }
.station-progress-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: var(--orange); }
.station-cell-effect { margin: 0; padding: 0; font-size: 16px; letter-spacing: 0.5px; color: var(--bone-soft); white-space: nowrap; -unity-text-align: middle-left; }
.station-row.service { background-color: var(--slate-600); }
.station-row.service .station-cell-effect { margin-top: 4px; }

/* ---------- the price button: a primary action ---------- */
#menuRoot .station-price { width: 92px; min-width: 92px; height: 42px; min-height: 0; flex-shrink: 0; margin: 0 0 0 20px; padding: 0; font-size: 20px; -unity-text-align: middle-center; border-width: 2px; border-color: transparent; border-bottom-color: var(--primary-edge); border-radius: 8px; background-color: var(--primary); background-image: none; color: var(--on-primary); -unity-font: url("/Assets/Content/UI/Fonts/LilitaOne-Regular.ttf"); -unity-font-definition: initial; }
#menuRoot .station-price:hover { background-color: var(--primary-hover); color: var(--on-primary); }
#menuRoot .station-price:active { background-color: var(--primary-press); }
#menuRoot.keyboard-navigation .station-price:focus { border-color: var(--bone); }
#menuRoot .station-price.just-bought { background-color: var(--bone); border-bottom-color: var(--bone-faint); color: var(--ink); }

/* cannot buy (out of reach, finished track, full battery): reads as disabled and has
   no hover or pressed reaction at all */
#menuRoot .station-price.short, #menuRoot .station-price.maxed, #menuRoot .station-price:disabled,
#menuRoot .station-price.short:hover, #menuRoot .station-price.maxed:hover, #menuRoot .station-price:disabled:hover {
    background-color: var(--slate-500); color: var(--bone-faint); border-color: transparent; opacity: 1;
}
