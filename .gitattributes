# Editable source art stays beside its exports; Git LFS stores the large content.
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text

# Purchased BK pack: binary payloads in LFS; Unity metadata and text stay diffable.
unity/Assets/BK/**/*.png filter=lfs diff=lfs merge=lfs -text
unity/Assets/BK/**/*.tga filter=lfs diff=lfs merge=lfs -text
unity/Assets/BK/**/*.fbx filter=lfs diff=lfs merge=lfs -text
unity/Assets/BK/**/*.exr filter=lfs diff=lfs merge=lfs -text
# Terrain and baked lighting data are binary across BK packs.
unity/Assets/BK/**/*Terrain*.asset filter=lfs diff=lfs merge=lfs -text
unity/Assets/BK/**/LightingData.asset filter=lfs diff=lfs merge=lfs -text

# Purchased tower crane pack: binary payloads in LFS; Unity metadata and text stay diffable.
unity/Assets/TowerCrane/**/*.png filter=lfs diff=lfs merge=lfs -text
unity/Assets/TowerCrane/**/*.fbx filter=lfs diff=lfs merge=lfs -text
unity/Assets/TowerCrane/**/*.pdf filter=lfs diff=lfs merge=lfs -text

# Purchased Hand Mining Drill: its model and source maps (kept outside Unity) in LFS, as are the project's 2K copies.
unity/Assets/HandMiningDrill/**/*.fbx filter=lfs diff=lfs merge=lfs -text
art/hand-mining-drill/source/*.png filter=lfs diff=lfs merge=lfs -text
unity/Assets/Content/ToolRig/MiningDrill/*.png filter=lfs diff=lfs merge=lfs -text
unity/Assets/Content/ToolRig/MiningDrill/*.asset filter=lfs diff=lfs merge=lfs -text

# Purchased Stylized Western Shovel: binary payloads in LFS, as is the project's copy of its metallic map.
unity/Assets/StylizedShovel/**/*.png filter=lfs diff=lfs merge=lfs -text
unity/Assets/StylizedShovel/**/*.fbx filter=lfs diff=lfs merge=lfs -text
unity/Assets/Content/ToolRig/WesternShovel/*.png filter=lfs diff=lfs merge=lfs -text

# Purchased Mining Tools, Ore & Ingots: binary payloads in LFS (only the files the game uses are committed).
