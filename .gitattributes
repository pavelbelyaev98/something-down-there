# Editable source art stays beside its exports; Git LFS stores the large content.
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text

# Purchased BK pack: binary payloads in LFS; Unity metadata and text stay diffable.
unity/Assets/BK/**/*.png filter=lfs diff=lfs merge=lfs -text
unity/Assets/BK/**/*.tga filter=lfs diff=lfs merge=lfs -text
unity/Assets/BK/**/*.fbx filter=lfs diff=lfs merge=lfs -text
unity/Assets/BK/**/*.exr filter=lfs diff=lfs merge=lfs -text
# Terrain and baked lighting data are binary across BK packs.
unity/Assets/BK/**/*Terrain*.asset filter=lfs diff=lfs merge=lfs -text
unity/Assets/BK/**/LightingData.asset filter=lfs diff=lfs merge=lfs -text

# Generated lakebed terrain data is binary even in Force Text mode.
unity/Assets/Content/Lakebed/*Terrain*.asset filter=lfs diff=lfs merge=lfs -text
unity/Assets/Scenes/**/OcclusionCullingData.asset filter=lfs diff=lfs merge=lfs -text

# Project texture copies retain the approved pack's binary storage policy.
unity/Assets/Content/Nature/GroundTextures/Gravel_*.png filter=lfs diff=lfs merge=lfs -text
unity/Assets/Content/Nature/GroundTextures/_RockDetail_*.png filter=lfs diff=lfs merge=lfs -text

# Purchased Odin tooling: preserve vendor binaries in the private repository via LFS.
unity/Assets/Plugins/Sirenix/**/*.dll filter=lfs diff=lfs merge=lfs -text
unity/Assets/Plugins/Sirenix/**/*.pdb filter=lfs diff=lfs merge=lfs -text
unity/Assets/Plugins/Sirenix/**/*.unitypackage filter=lfs diff=lfs merge=lfs -text
unity/Assets/Plugins/Sirenix/**/*.bytes filter=lfs diff=lfs merge=lfs -text
unity/Assets/Plugins/Sirenix/**/*.png filter=lfs diff=lfs merge=lfs -text
unity/Assets/Plugins/Sirenix/**/*.data filter=lfs diff=lfs merge=lfs -text
